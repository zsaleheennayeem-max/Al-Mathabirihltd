# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
PORT=3000

# Cloud SQL / PostgreSQL Database Connection (Used in AIS & Production)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="postgres"
SQL_USER="postgres"
SQL_PASSWORD="your_secure_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_secure_password"

# Standard PostgreSQL Connection String (Hostinger VPS / Docker Compose)
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/equipworkforce?schema=public"

# SMTP Email Configuration (For Contact & Manpower Requisition Notifications)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=587
SMTP_USER="notifications@yourdomain.com"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM="EquipWorkforce <notifications@yourdomain.com>"

